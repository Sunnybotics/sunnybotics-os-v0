<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sunnybotics_adapter</name>
  <version>0.1.0</version>
  <description>
    The bridge between the ROS 2 machine layer and the SunnyboticsOS Mission
    Engine. Subscribes to every /machines/*/state it can discover, serves that
    fleet over REST/JSON, and turns POST /missions into Mission action goals.
    The OS never speaks ROS and the machines never speak HTTP.
  </description>
  <maintainer email="maintainers@sunnybotics.invalid">SunnyboticsOS Machine Layer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sunnybotics_cmi</depend>
  <depend>action_msgs</depend>

  <!-- Installed by apt as python3-fastapi / python3-uvicorn, so they live in
       the same interpreter as rclpy. A venv works too, provided it is created
       with the system-site-packages flag or rclpy will not be importable. -->
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
